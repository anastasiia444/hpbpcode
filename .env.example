# Скопіюйте цей файл у .env і заповніть. Файл .env нікому не надсилайте.

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=

# Ваш Telegram ID. Залиште порожнім, запустіть бота і напишіть йому: він покаже ваш ID
ALLOWED_TELEGRAM_USER_ID=

# Ключ Claude API з platform.claude.com
ANTHROPIC_API_KEY=

# Модель і глибина роздумів (low, medium, high)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

TIMEZONE=Europe/Kyiv
# О котрій годині надсилати план на день (будні) і тижневий звіт
DAILY_DIGEST_HOUR=9
# День тижневого звіту: 0 = понеділок … 6 = неділя
WEEKLY_REPORT_WEEKDAY=0

# Google Calendar (необов'язково). Ваша Gmail-адреса або ID календаря
GOOGLE_CALENDAR_ID=
# Ключ сервісного акаунта Google покласти в data/google-service-account.json
